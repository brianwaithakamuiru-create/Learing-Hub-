rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User Profile Documents (Private to the student)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // When creating account, role must be 'student' or not self-escalated to admin
      allow create: if request.auth != null && request.auth.uid == userId 
                    && (!('role' in request.resource.data) || request.resource.data.role == 'student');
      // When updating account, user cannot self-escalate their role to admin
      allow update: if request.auth != null && request.auth.uid == userId 
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // All private subcollections under users/{userId} (timetable, notes, documents, units, assignments, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Unique Usernames Directory
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Official CUE Kenyan Universities & Institutions Directory
    // Publicly readable so prospective and registered students across Kenya can search universities, campuses, programmes, facilities
    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /universities/{universityId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Public Campus Announcements, Events, Facilities Directories
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sports/{sportId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /programmes/{programmeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /units/{unitId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Personal Academic Root Collections (partitioned by ownerId == request.auth.uid)
    match /{collectionName}/{docId} {
      allow read: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
